DRIVER=~aiohttp
HOST=0.0.0.0
PORT=443
LOG_LEVEL=INFO
COMMAND_START=["/", ""]


QQ_APPID=你的AppID
QQ_SECRET=你的AppSecret

# OpenUptime webhook（URL 里带 token，例如 /webhook/abc123）
WEBHOOK_TOKEN=change-me
# 告警转发到的 QQ 群 openid（群聊日志里的 [Group:...]）
WEBHOOK_QQ_GROUP=

ARCAEA_API_BASE=https://arcapi-v3.arcaxa.xin/api/v1
ARCAEA_API_TOKEN=change-me
ARCAEA_API_TIMEOUT=60
ARCAEA_B50_COUNT=50
ARCAEA_SCORE_TOP_N=10
ARCAEA_COMPLETION_MIN=9.0
ARCAEA_COMPLETION_MAX=12.0
ARCAEA_IMAGE_QUALITY=90
ARCAEA_OUTPUT_WIDTH=1280
ARCAEA_RENDER_CONCURRENCY=2
